# PITCH (public Streamlit repo) — keep this clean.
# Only Streamlit display code + small data parquets get committed.

__pycache__/
*.pyc
.venv/
.env
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Streamlit local cache
.streamlit/secrets.toml

# Logs
output/logs/

# Anything from the private model repo accidentally landing here.
# (Specifically the model code — it should NEVER live in this repo.)
scrapers/
pipeline/
models/
data/
config_secrets.py
docs/

# Whitelist: small per-day fixture metadata used by the Streamlit slate
# (logos, venues, kickoffs). Mirrored from the private repo's
# data/processed/today_fixtures.parquet by daily_auto_update.bat.
!data/
!data/processed/
!data/processed/today_fixtures.parquet
